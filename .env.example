# PRIMARY odds source — API-Football, https://www.api-football.com
# Free tier: 100 requests/day, native 1X2 decimal odds for all major leagues.
# Get a free key at https://dashboard.api-football.com/register (no card required).
# The app uses ~3 requests per cache refresh (one per day, 3-day horizon).
API_FOOTBALL_KEY=

# Legacy alternative — The Odds API, https://the-odds-api.com
# Free tier: 500 requests/month. Used only if API_FOOTBALL_KEY is empty/unreachable.
ODDS_API_KEY=

# Google AI Studio (Gemini) — https://aistudio.google.com/apikey
# Powers the live "Query AI" sentiment engine. Without it the app uses the
# instant seeded sentiment model for every match.
GEMINI_API_KEY=

# Optional: override the Gemini model used for live analysis.
GEMINI_MODEL=gemini-2.5-flash