# PRIMARY odds source — The Odds API, https://the-odds-api.com
# Free tier: 500 requests/month. A full pool refresh = 23 requests (one per
# league), cached for 15 minutes server-side. Falls back to a realistic
# simulated fixture pool when this key is missing.
ODDS_API_KEY=

# Google AI Studio (Gemini) — https://aistudio.google.com/apikey
# Powers the live "Query AI" sentiment engine. Without it the app uses the
# instant seeded sentiment model for every match.
GEMINI_API_KEY=

# Optional: override the Gemini model used for live analysis.
GEMINI_MODEL=gemini-2.5-flash